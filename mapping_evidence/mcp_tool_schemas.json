  {
    "name": "xair_set",
    "title": null,
    "description": "Set any OSC parameter on the mixer and read back for confirmation.\n\n    Args:\n        address: OSC address, e.g. '/ch/05/mix/fader'\n        value: the value. If `unit` given (or the map defines one for a float\n               param), human units are converted to wire format automatically:\n               e.g. address='/ch/05/mix/fader', value=-6, unit='fader_db'.\n        unit: '', a unit name from xair_map_describe, or 'raw' to skip conversion.\n    Returns the confirmed value after setting.\n    ",
    "inputSchema": {
      "properties": {
        "address": {
          "title": "Address",
          "type": "string"
